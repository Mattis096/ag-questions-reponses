<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Assemblée Générale - Questions / Réponses</title>

    <link rel="icon" type="image/png" href="/images/favicon.png">

    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="page">

        <header class="page-header">
            <img
                src="/images/logo.png"
                alt="Fédération Française de Cyclotourisme"
                class="logo"
            >

            <p class="organization">
                FÉDÉRATION FRANÇAISE DE CYCLOTOURISME
            </p>

            <h1>{{ event_name }}</h1>

            <p class="event-date">
                {{ event_dates_formatted }} - {{ event_city }} ({{ event_department }})
            </p>

            <h2>POSEZ VOS QUESTIONS AU COMITÉ DIRECTEUR FÉDÉRAL</h2>
        </header>

        <div class="deadline">
            DATE LIMITE DE RÉCEPTION :
            {{ question_deadline_formatted }}
        </div>

        <main class="form-container">

            <p class="required-info">
                Les champs marqués d'une * sont obligatoires.
            </p>

            {{ form_start(form) }}

            <section class="form-section">

                <div class="form-row">
                    <div class="form-field">
                        {{ form_row(form.first_name) }}
                    </div>

                    <div class="form-field">
                        {{ form_row(form.last_name) }}
                    </div>
                </div>

                <div class="form-field full-width">
                    {{ form_row(form.email) }}
                </div>

            </section>

            <section class="form-section">

                <h3>CLUB</h3>

                <div class="form-row">
                    <div class="form-field">
                        {{ form_row(form.club) }}
                    </div>

                    <div class="form-field">
                        {{ form_row(form.club_function) }}
                    </div>
                </div>

            </section>

            <section class="form-section">

                <h3>DÉPARTEMENT</h3>

                <div class="form-row">
                    <div class="form-field">
                        {{ form_row(form.department) }}
                    </div>

                    <div class="form-field">
                        {{ form_row(form.department_function) }}
                    </div>
                </div>

            </section>

            <section class="form-section">

                <h3>RÉGION</h3>

                <div class="form-row">
                    <div class="form-field">
                        {{ form_row(form.region) }}
                    </div>

                    <div class="form-field">
                        {{ form_row(form.region_function) }}
                    </div>
                </div>

            </section>

            <section class="questions-section">

                <h3>VOS QUESTIONS</h3>

                <div class="form-field">
                    {{ form_row(form.question_1) }}
                </div>

                <div class="form-field">
                    {{ form_row(form.question_2) }}
                </div>

                <div class="form-field">
                    {{ form_row(form.question_3) }}
                </div>

            </section>

            <div class="consent">
                {{ form_row(form.consent) }}
            </div>

            <div class="form-submit">
                {{ form_row(form.submit) }}
            </div>

            {{ form_end(form) }}

        </main>

    </div>
</body>
</html>